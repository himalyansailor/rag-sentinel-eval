# Copy to .env and adjust. Every setting is documented in docs/LLD.md §3.

# --- Judge: the open-source LLM that grades answers -------------------------
SENTINEL_JUDGE__PROVIDER=ollama              # ollama | openai_compatible (vLLM, TGI, LM Studio)
SENTINEL_JUDGE__BASE_URL=http://localhost:11434
SENTINEL_JUDGE__MODEL=qwen2.5:3b
# SENTINEL_JUDGE__API_KEY=                   # only for OpenAI-compatible servers that need one
SENTINEL_JUDGE__TIMEOUT_S=120
SENTINEL_JUDGE__MAX_RETRIES=3

# --- Embeddings (retrieval + answer relevance) ------------------------------
SENTINEL_EMBEDDINGS__PROVIDER=ollama         # ollama | hashing (offline, lexical only)
SENTINEL_EMBEDDINGS__MODEL=nomic-embed-text

# --- Reference RAG pipeline (system under test) -----------------------------
SENTINEL_PIPELINE__CORPUS_DIR=data/corpus
SENTINEL_PIPELINE__GENERATOR=ollama          # ollama | extractive (offline baseline)
SENTINEL_PIPELINE__GENERATOR_MODEL=llama3.2:3b
SENTINEL_PIPELINE__TOP_K=4

# --- Quality gate ------------------------------------------------------------
SENTINEL_GATE__THRESHOLDS={"faithfulness": 0.85}
SENTINEL_GATE__MAX_ERROR_RATE=0.2

# --- Runtime -----------------------------------------------------------------
SENTINEL_EVALUATION__MAX_CONCURRENCY=4
SENTINEL_STORAGE__DB_PATH=.sentinel/history.db
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=false
