// Golden dataset for the bundled Northwind Cloud corpus. One JSON object per line.
{"id": "refund-monthly-window", "question": "How long do monthly plan customers have to request a full refund?", "ground_truth": "Customers on monthly plans can request a full refund within 14 days of their first payment.", "metadata": {"topic": "billing"}}
{"id": "refund-usage-charges", "question": "Can I get a refund for API overage fees?", "ground_truth": "No. Refunds are not available for usage-based charges such as compute hours, egress bandwidth or API overage fees.", "metadata": {"topic": "billing"}}
{"id": "refund-timeline", "question": "How long does it take for an approved refund to arrive?", "ground_truth": "Approved refunds are returned to the original payment method within 5 to 10 business days.", "metadata": {"topic": "billing"}}
{"id": "cancel-data-retention", "question": "What happens to my data after I cancel my subscription?", "ground_truth": "After cancellation, data is retained for 30 days and then permanently deleted.", "metadata": {"topic": "billing"}}
